{
  "expo": {
    "name": "zonekite",
    "slug": "zonekite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zonekite.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zonekite.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#062E45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ZoneKite a besoin d'accéder à vos photos pour choisir votre photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9d28ae2b-4760-4de5-8710-713a80256735"
      }
    },
    "owner": "feles-team"
  }
}
