rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil utilisateur : lisible/modifiable uniquement par son propriétaire.
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trajets de covoiturage : visibles par tous les membres connectés,
    // création libre. Le conducteur (identifié par conducteurUid, absent
    // sur les trajets créés avant ce champ — ceux-là restent non
    // modifiables) peut librement éditer ou supprimer son propre trajet,
    // à condition de ne pas réattribuer conducteurUid à quelqu'un d'autre.
    // Couvre aussi la mise à jour de placesDispo seule (acceptation d'une
    // demande de place).
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.conducteurUid == request.auth.uid
        && request.resource.data.conducteurUid == resource.data.conducteurUid;
      allow delete: if request.auth != null && resource.data.conducteurUid == request.auth.uid;
    }

    // Sujets de forum : visibles par tous les membres connectés, création
    // libre. La mise à jour n'est autorisée que pour ajouter un commentaire :
    // seul le champ "commentaires" peut changer, il ne peut que grandir d'un
    // élément, et les commentaires déjà présents doivent rester intacts —
    // impossible donc de réécrire le titre/contenu/auteur d'un post, ou de
    // modifier/supprimer un commentaire existant (y compris le sien).
    match /forumPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentaires'])
        && request.resource.data.commentaires.size() == resource.data.commentaires.size() + 1
        && request.resource.data.commentaires.hasAll(resource.data.commentaires);
    }

    // Demandes de place en covoiturage : lisibles par tous les membres
    // connectés (le conducteur doit voir les demandes reçues sur son
    // trajet), créées uniquement par le demandeur pour lui-même et
    // toujours au statut initial "pending". Seul le conducteur du trajet
    // concerné (comparé via conducteurUid sur le trajet) peut faire passer
    // une demande à "accepted" ou "refused", et uniquement ce champ-là —
    // un trajet créé avant l'introduction de conducteurUid ne peut donc
    // plus recevoir de réponse (dégradation sûre plutôt qu'ouverte).
    match /rideRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.passagerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.conducteurUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'refused'];
    }
  }
}
