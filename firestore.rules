rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil utilisateur : lisible/modifiable uniquement par son propriétaire.
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trajets de covoiturage : visibles par tous les membres connectés,
    // création libre. Le conducteur (identifié par conducteurUid, absent
    // sur les trajets créés avant ce champ — ceux-là restent non
    // modifiables) peut librement éditer ou supprimer son propre trajet,
    // à condition de ne pas réattribuer conducteurUid à quelqu'un d'autre.
    // Couvre aussi la mise à jour de placesDispo seule (acceptation d'une
    // demande de place).
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.conducteurUid == request.auth.uid
        && request.resource.data.conducteurUid == resource.data.conducteurUid;
      allow delete: if request.auth != null && resource.data.conducteurUid == request.auth.uid;
    }

    // Sujets de forum : visibles par tous les membres connectés, créés
    // uniquement par leur auteur (auteurUid). Le propriétaire peut éditer
    // titre/contenu/tag ou supprimer son post, sans le réattribuer à
    // quelqu'un d'autre. N'importe quel membre peut en revanche faire
    // avancer commentCount d'une unité en postant une réponse (voir la
    // sous-collection comments ci-dessous, seule source des commentaires
    // pour les nouveaux posts).
    match /forumPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.auteurUid == request.auth.uid;
      allow update: if request.auth != null
        && (
          (resource.data.auteurUid == request.auth.uid
            && request.resource.data.auteurUid == resource.data.auteurUid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            // .get(key, 0) : les posts créés avant l'introduction de
            // commentCount n'ont pas ce champ, on part de 0 pour eux.
            && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1)
        );
      allow delete: if request.auth != null && resource.data.auteurUid == request.auth.uid;

      // Réponses à un sujet : lisibles par tous les membres connectés,
      // créées par leur auteur pour lui-même, éditées/supprimées
      // uniquement par ce même auteur (auteurUid), sans réattribution.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.auteurUid == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.auteurUid == request.auth.uid
          && request.resource.data.auteurUid == resource.data.auteurUid;
        allow delete: if request.auth != null && resource.data.auteurUid == request.auth.uid;
      }
    }

    // Demandes de place en covoiturage : lisibles par tous les membres
    // connectés (le conducteur doit voir les demandes reçues sur son
    // trajet), créées uniquement par le demandeur pour lui-même et
    // toujours au statut initial "pending". Seul le conducteur du trajet
    // concerné (comparé via conducteurUid sur le trajet) peut faire passer
    // une demande à "accepted" ou "refused", et uniquement ce champ-là —
    // un trajet créé avant l'introduction de conducteurUid ne peut donc
    // plus recevoir de réponse (dégradation sûre plutôt qu'ouverte).
    match /rideRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.passagerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.conducteurUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'refused'];
    }
  }
}
