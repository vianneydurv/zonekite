rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin : compte présent dans admins/{uid}. Ces documents se créent
    // uniquement depuis la console Firebase (aucune écriture depuis l'app).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Membre banni par un admin : ne peut plus rien publier.
    function isBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    match /admins/{userId} {
      // Lisible par tous les membres : l'app de chacun doit savoir à qui
      // envoyer les alertes de modération.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bannissements : posés/levés par un admin, lisibles par l'intéressé
    // (écran « compte suspendu ») et par les admins.
    match /bans/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Annuaire public des membres (prénom, photo) : sert au compteur de
    // membres du forum et à la liste des membres de l'espace admin.
    match /members/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Signalements (manuels ou automatiques) : créés par n'importe quel
    // membre en son nom, lus et traités par les admins uniquement.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // Retours / avis envoyés depuis le profil : même principe.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // Profil utilisateur : lisible/modifiable uniquement par son propriétaire.
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Jeton de notification push d'un utilisateur : lisible par tout membre
    // connecté (l'app de l'expéditeur envoie la notification elle-même via
    // l'API Expo, sans serveur), modifiable uniquement par son propriétaire.
    match /pushTokens/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Trajets de covoiturage : visibles par tous les membres connectés,
    // création libre. Le conducteur (identifié par conducteurUid, absent
    // sur les trajets créés avant ce champ — ceux-là restent non
    // modifiables) peut librement éditer ou supprimer son propre trajet,
    // à condition de ne pas réattribuer conducteurUid à quelqu'un d'autre.
    // Couvre aussi la mise à jour de placesDispo seule (acceptation d'une
    // demande de place).
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.conducteurUid == request.auth.uid
        && !isBanned();
      allow update: if request.auth != null
        && resource.data.conducteurUid == request.auth.uid
        && request.resource.data.conducteurUid == resource.data.conducteurUid;
      allow delete: if request.auth != null && (resource.data.conducteurUid == request.auth.uid || isAdmin());
    }

    // Sujets de forum : visibles par tous les membres connectés, créés
    // uniquement par leur auteur (auteurUid). Le propriétaire peut éditer
    // titre/contenu/tag ou supprimer son post, sans le réattribuer à
    // quelqu'un d'autre. N'importe quel membre peut en revanche faire
    // avancer commentCount d'une unité en postant une réponse (voir la
    // sous-collection comments ci-dessous, seule source des commentaires
    // pour les nouveaux posts).
    match /forumPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.auteurUid == request.auth.uid
        && !isBanned();
      allow update: if request.auth != null
        && (
          (resource.data.auteurUid == request.auth.uid
            && request.resource.data.auteurUid == resource.data.auteurUid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            // .get(key, 0) : les posts créés avant l'introduction de
            // commentCount n'ont pas ce champ, on part de 0 pour eux.
            // -1 : suppression d'une réponse (par son auteur ou un admin).
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
              || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
        );
      allow delete: if request.auth != null && (resource.data.auteurUid == request.auth.uid || isAdmin());

      // Réponses à un sujet : lisibles par tous les membres connectés,
      // créées par leur auteur pour lui-même, éditées/supprimées
      // uniquement par ce même auteur (auteurUid), sans réattribution.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.auteurUid == request.auth.uid
          && !isBanned();
        allow update: if request.auth != null
          && resource.data.auteurUid == request.auth.uid
          && request.resource.data.auteurUid == resource.data.auteurUid;
        allow delete: if request.auth != null && (resource.data.auteurUid == request.auth.uid || isAdmin());
      }
    }

    // Demandes de place en covoiturage : lisibles par tous les membres
    // connectés (le conducteur doit voir les demandes reçues sur son
    // trajet), créées uniquement par le demandeur pour lui-même et
    // toujours au statut initial "pending". Seul le conducteur du trajet
    // concerné (comparé via conducteurUid sur le trajet) peut faire passer
    // une demande à "accepted" ou "refused", et uniquement ce champ-là —
    // un trajet créé avant l'introduction de conducteurUid ne peut donc
    // plus recevoir de réponse (dégradation sûre plutôt qu'ouverte).
    match /rideRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.passagerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !isBanned();
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.conducteurUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'refused'];
      // Le demandeur peut supprimer sa propre demande (ex. suppression de
      // compte).
      allow delete: if request.auth != null && (resource.data.passagerUid == request.auth.uid || isAdmin());
    }
  }
}
